# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- Required: the LLM (reasoning + tool calling + recipe generation)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash         # conversation model (default shown)
# GEMINI_RECIPE_MODEL=                  # model for get_recipe; defaults to GEMINI_MODEL
# GEMINI_THINKING_LEVEL=low             # minimal | low | medium | high; lower = faster first token

# --- Recommended: Deepgram streaming STT + TTS (lowest latency)
# Without this key, STT/TTS fall back to offline Vosk + pyttsx3 (pip install -e ".[offline]").
DEEPGRAM_API_KEY=
# DEEPGRAM_STT_MODEL=nova-3
# DEEPGRAM_TTS_MODEL=aura-2-thalia-en
# DEEPGRAM_ENDPOINTING_MS=300           # silence that ends an utterance; lower = snappier, more cut-offs

# --- Provider selection: auto picks Deepgram when its key is set, else offline
# STT_PROVIDER=auto                     # auto | deepgram | vosk
# TTS_PROVIDER=auto                     # auto | deepgram | pyttsx3
# LLM_PROVIDER=gemini

# --- Offline STT model (only for STT_PROVIDER=vosk / auto without Deepgram)
# VOSK_MODEL_PATH=/path/to/vosk-model-small-en-us-0.15

# --- Behaviour
# WAKE_WORD=                            # empty = always listening; e.g. "chef" to require a wake word
# BARGE_IN=true                         # talk over the assistant to interrupt it
# METRICS_LOG=metrics.jsonl             # append per-turn latency records here
